# --- required -----------------------------------------------------------
DATABASE_URL="postgresql://user:pass@host:5432/radar"

# --- protects /api/refresh, the worker queue and the extension endpoints --
# Leave unset for localhost. Set it on any public deployment.
RADAR_TOKEN=""

# --- optional -----------------------------------------------------------
# Where the worker and scripts look for the app.
RADAR_URL="http://localhost:3000"

# Set to 0 to skip the browser worker and always hand you the link instead.
APPLY_WORKER_ENABLED="1"

# Direct ATS submission needs an employer-issued key; there is no public one.
# Anything not listed here falls back to browser automation.
# GREENHOUSE_BOARD_KEYS='{"anthropic":"<job board api key>"}'
# LEVER_APPLY_KEYS='{"palantir":"<posting api key>"}'
